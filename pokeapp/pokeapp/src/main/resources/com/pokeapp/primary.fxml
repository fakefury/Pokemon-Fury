<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.pokeapp.controller.PrimaryController" style="-fx-background-color: #17202a;">
 <center><VBox alignment="CENTER" spacing="22" style="-fx-background-color: #f4f6f7; -fx-background-radius: 18; -fx-padding: 45;" maxWidth="520">
  <Label text="POKEAPP" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
  <Label text="Elegí tu equipo. Prepará tu estrategia. Ganá el combate." wrapText="true" style="-fx-font-size: 16px; -fx-text-fill: #566573;"/>
  <Button text="NUEVA PARTIDA" onAction="#comenzar" prefWidth="240" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 12 20;"/>
  <Button text="SALIR" onAction="#salir" prefWidth="240" style="-fx-font-size: 14px; -fx-padding: 10 20;"/>
 </VBox></center>
</BorderPane>
