<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pokeapp.controller.TeamController" styleClass="game-root">
    <top>
        <VBox spacing="6" styleClass="screen-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="POKÉMON FURY" styleClass="header-brand" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="SELECCIÓN DE EQUIPO" styleClass="header-chip" />
            </HBox>
            <Label text="Elegí seis Pokémon. Los otros seis serán el equipo rival." styleClass="header-description" />
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="team-scroll">
            <content>
                <VBox spacing="12" styleClass="team-content">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="CATÁLOGO POKÉMON" styleClass="section-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="contador" text="EQUIPO: 0 / 6" styleClass="team-counter" />
                    </HBox>
                    <TilePane fx:id="listaPokemones" prefColumns="4" hgap="14" vgap="14"
                              alignment="CENTER" tileAlignment="CENTER" prefTileWidth="178" prefTileHeight="166" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="9" styleClass="bottom-bar">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="ENTRENADOR" styleClass="field-label" />
                <TextField fx:id="nombreEntrenador" promptText="Tu nombre" prefWidth="210" styleClass="retro-input" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="6 POKÉMON PARA COMENZAR" styleClass="bottom-hint" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="mensaje" text="Seleccioná seis tarjetas para armar tu equipo." styleClass="feedback-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="VOLVER" onAction="#volverMenu" styleClass="game-button secondary-button" />
                <Button fx:id="botonConfirmar" text="¡A COMBATIR!  ▶" onAction="#confirmarEquipo"
                        disable="true" styleClass="game-button primary-game-button" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
